# Server
PORT=8080
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orbitsms

# Authentication — required, no default
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourapp.com

# Logging
LOG_LEVEL=info

# Feature flags
ENABLE_PUBLIC_REGISTRATION=false
